    "def extract_cn_vicuna_answer(a):\n",
    "    start_pos = a.index(\"### Response:\\n\")+len(\"### Response:\\n\")\n",
    "    try:\n",
    "        end_pos = a.index('\\n\\n##', start_pos)\n",
    "    except Exception as e:\n",
    "        end_pos = len(a)\n",
    "    \n",
    "    return a[start_pos:end_pos]"
   ]
  },
